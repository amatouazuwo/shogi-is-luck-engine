+/// A quiet opponent move cannot both occupy two distinct empty drop squares and
+/// take a piece from our hand. A non-pawn drop outside check is legal on any empty
+/// square in its allowed ranks. Thus a quiet last ply cannot end the game here.
+fn guaranteed_drop_after_quiet(position: &Position, defender: Color) -> bool {
+    let hand = position.hand(defender);
+    if hand == rsshogi::types::Hand::ZERO {
+        return false;
+    }
+    let open = position.empties().and_not(position.obstacle_mask());
+    if !open.more_than_one() {
+        return false;
+    }
+    if [PieceType::GOLD, PieceType::SILVER, PieceType::BISHOP, PieceType::ROOK]
+        .into_iter()
+        .any(|piece| hand.has(piece))
+    {
+        return true;
+    }
+    let (last, second_last) = if defender == Color::BLACK {
+        (Rank::RANK_1, Rank::RANK_2)
+    } else {
+        (Rank::RANK_9, Rank::RANK_8)
+    };
+    let lance_squares = open.and_not(Bitboard::rank_mask(last));
+    (hand.has(PieceType::LANCE) && lance_squares.more_than_one())
+        || (hand.has(PieceType::KNIGHT)
+            && lance_squares.and_not(Bitboard::rank_mask(second_last)).more_than_one())
+}
