+    #[test]
+    fn dynamic_drop_proof_matches_full_leaves_in_both_hazards() {
+        board::init();
+        let arrays: &[&[&str]] =
+            &[&["5e"], &["4d", "5d", "6d", "4e", "5e", "6e", "4f", "5f", "6f"]];
+        let mut state = 696320u64;
+        let mut witnessed = 0;
+        for holes in arrays {
+            let mut mask = Bitboard::EMPTY;
+            for square in *holes {
+                mask.set(Square::from_usi(square).unwrap());
+            }
+            for _ in 0..8 {
+                let sfen = "lnsgk1snl/1r5b1/ppppppppp/9/9/9/PPPPPPPPP/1B5R1/LNSGK1SNL b Gg 1";
+                let mut position = board::position_from_sfen(sfen).unwrap();
+                assert!(position.set_obstacle_mask(mask));
+                for _ in 0..12 {
+                    let attacker = position.turn();
+                    if guaranteed_drop_after_quiet(&position, attacker.flip()) {
+                        let mut fast = Probe {
+                            start: Instant::now(),
+                            budget: Duration::MAX,
+                            nodes: 0,
+                            use_drop_witness: true,
+                            drop_witness_leaves: 0,
+                        };
+                        let mut exhaustive = Probe { use_drop_witness: false, ..fast };
+                        let first = fast.exact_forced(&mut position, attacker, 1);
+                        let second = exhaustive.exact_forced(&mut position, attacker, 1);
+                        assert_eq!(first, second, "{}", position.to_sfen(None));
+                        witnessed += fast.drop_witness_leaves;
+                    }
+                    let mut moves = Move32List::new();
+                    board::generate_legal_all_move32(&position, &mut moves);
+                    if moves.as_slice().is_empty() {
+                        break;
+                    }
+                    state ^= state << 13;
+                    state ^= state >> 7;
+                    state ^= state << 17;
+                    let index = (state % moves.as_slice().len() as u64) as usize;
+                    position.apply_move32(moves.as_slice()[index]);
+                }
+            }
+        }
+        assert!(witnessed >= 32, "only {witnessed} accelerated control nodes");
+    }
+
+    #[test]
+    fn no_drop_witness_without_two_unblocked_live_squares() {
+        board::init();
+        let position = board::position_from_sfen("k8/9/9/9/9/9/9/9/8K b p 1").unwrap();
+        assert!(!guaranteed_drop_after_quiet(&position, Color::WHITE));
+        let mut position = board::position_from_sfen("k8/9/9/9/9/9/9/9/8K b n 1").unwrap();
+        let abundant = guaranteed_drop_after_quiet(&position, Color::WHITE);
+        let usable = Square::from_usi("6f").unwrap();
+        let mut allowed = position.pieces();
+        allowed.set(usable);
+        for file in 1..=8 {
+            allowed.set(Square::from_usi(&format!("{file}i")).unwrap());
+        }
+        assert!(position.set_obstacle_mask(Bitboard::ALL.and_not(allowed)));
+        assert!(abundant);
+        assert!(!guaranteed_drop_after_quiet(&position, Color::WHITE));
+    }
