+//! Bounded, constructive tactical loss detection at the obstacle root.
+
+use rsshogi::board::{self, Captures, Move32List, Position};
+use rsshogi::mate::solve_mate_in_one;
+use rsshogi::types::{Color, Move32, PieceType};
+use serde::Serialize;
+use std::time::Duration;
+
+use super::context::tt_key;
+use super::score::score_from_tt;
+use super::time::Instant;
+use super::tt::TranspositionTable;
+use crate::eval::Evaluator;
+use crate::position::SearchPositionExt;
+
+const HORIZON: u8 = 5;
+const MAX_NODES: u32 = 12_000;
+
+#[derive(Serialize)]
+pub(crate) struct ObstacleGuardOutput {
+    pub(crate) status: &'static str,
+    pub(crate) bestmove: String,
+    pub(crate) nodes: u32,
+    pub(crate) proof_nodes: u32,
+    pub(crate) proof_ms: u64,
+    pub(crate) elapsed_ms: u64,
+    pub(crate) replacement_score: Option<i32>,
+}
+
+struct Probe {
+    start: Instant,
+    budget: Duration,
+    nodes: u32,
+}
+
+impl Probe {
+    fn alive(&self) -> bool {
+        self.nodes < MAX_NODES && self.start.elapsed() < self.budget
+    }
+
+    /// Completeness applies only to the chosen attacking move subset. A positive
+    /// result covers every legal response and therefore proves the loss regardless.
+    fn forced(&mut self, position: &mut Position, attacker: Color, remaining: u8) -> Option<bool> {
+        if !self.alive() {
+            return None;
+        }
+        self.nodes += 1;
+        if position.turn() == attacker {
+            if remaining == 0 {
+                return Some(false);
+            }
+            if solve_mate_in_one(position).is_some() {
+                return Some(true);
+            }
+            if remaining == 1 {
+                return Some(false);
+            }
+            let moves = forcing_moves(position);
+            for (_, mv) in moves {
+                position.apply_move32(mv);
+                let won = self.forced(position, attacker, remaining - 1);
+                position.undo_move32(mv).expect("guard move was legal");
+                if won? {
+                    return Some(true);
+                }
+            }
+            Some(false)
+        } else {
+            if remaining == 0 {
+                return Some(position.is_mated());
+            }
+            let mut replies = Move32List::new();
+            board::generate_legal_all_move32(position, &mut replies);
+            for &mv in replies.as_slice() {
+                position.apply_move32(mv);
+                let won = self.forced(position, attacker, remaining - 1);
+                position.undo_move32(mv).expect("guard response was legal");
+                if !won? {
+                    return Some(false);
+                }
+            }
+            Some(true)
+        }
+    }
+}
+
+/// Only checked moves and near-king captures can be proving attacker steps.
+fn forcing_moves(position: &Position) -> Vec<(i32, Move32)> {
+    let owner = position.turn();
+    let enemy_king = position.king_square(owner.flip());
+    let mut moves = Move32List::new();
+    board::movegen::generate_checks_all_move32(position, &mut moves);
+    let mut candidates: Vec<_> = moves
+        .as_slice()
+        .iter()
+        .copied()
+        .filter(|&mv| position.is_legal_move32(mv))
+        .map(|mv| {
+            let distance = i32::from(enemy_king.distance(mv.to_sq()));
+            (2000 - 15 * distance, mv)
+        })
+        .collect();
+    let mut captures = Move32List::new();
+    board::generate_moves_move32::<Captures>(position, &mut captures);
+    for &mv in captures.as_slice() {
+        let distance = i32::from(enemy_king.distance(mv.to_sq()));
+        if distance > 2
+            || candidates.iter().any(|&(_, existing)| existing == mv)
+            || !position.is_legal_move32(mv)
+        {
+            continue;
+        }
+        let moving = position.move_facts(mv).piece_after_move().piece_type();
+        let priority = if moving == PieceType::KING { 2400 } else { 1800 };
+        candidates.push((priority - 15 * distance, mv));
+    }
+    candidates.sort_by_key(|&(priority, _)| std::cmp::Reverse(priority));
+    candidates
+}
+
+fn compare_after(
+    probe: &mut Probe,
+    position: &mut Position,
+    attacker: Color,
+    mv: Move32,
+) -> Option<bool> {
+    position.apply_move32(mv);
+    let verdict = probe.forced(position, attacker, HORIZON);
+    position.undo_move32(mv).expect("guard root candidate was legal");
+    verdict
+}
+
+pub(crate) fn guard_obstacle_move(
+    source: &Position,
+    incumbent: Move32,
+    table: &TranspositionTable,
+    mut evaluator: Evaluator,
+    movetime_ms: u64,
+    allow_replacement: bool,
+) -> ObstacleGuardOutput {
+    let mut probe =
+        Probe { start: Instant::now(), budget: Duration::from_millis(movetime_ms), nodes: 0 };
+    let mut position = source.clone_for_search();
+    let attacker = position.turn().flip();
+    let outcome = compare_after(&mut probe, &mut position, attacker, incumbent);
+    let proof_nodes = probe.nodes;
+    let proof_ms = probe.start.elapsed().as_millis().min(u128::from(u64::MAX)) as u64;
+    let mut selected = incumbent;
+    let mut replacement_score = None;
+    let mut status = match outcome {
+        Some(true) => "proved-loss",
+        Some(false) => "not-proved-in-subset",
+        None => "budget",
+    };
+    if outcome == Some(true) && allow_replacement && probe.alive() {
+        let mut alternatives = Vec::new();
+        let mut moves = Move32List::new();
+        board::generate_legal_all_move32(&position, &mut moves);
+        evaluator.initialize(&position);
+        for &candidate in moves.as_slice() {
+            if candidate == incumbent {
+                continue;
+            }
+            if !probe.alive() {
+                break;
+            }
+            position.apply_move32(candidate);
+            let score = table
+                .probe(tt_key(&position, 0))
+                .map(|entry| -score_from_tt(entry.score, 1))
+                .unwrap_or_else(|| {
+                    evaluator.advance(&position, candidate);
+                    let score = -evaluator.evaluate(&position);
+                    evaluator.undo();
+                    score
+                });
+            position.undo_move32(candidate).expect("guard candidate was legal");
+            alternatives.push((score, candidate));
+        }
+        alternatives.sort_by_key(|&(score, _)| std::cmp::Reverse(score));
+        for (score, candidate) in alternatives {
+            if compare_after(&mut probe, &mut position, attacker, candidate) == Some(false)
+                && probe.alive()
+            {
+                selected = candidate;
+                replacement_score = Some(score);
+                status = "replaced-proved-loss";
+                break;
+            }
+            if !probe.alive() {
+                break;
+            }
+        }
+    }
+    ObstacleGuardOutput {
+        status,
+        bestmove: selected.to_usi(),
+        nodes: probe.nodes,
+        proof_nodes,
+        proof_ms,
+        elapsed_ms: probe.start.elapsed().as_millis().min(u128::from(u64::MAX)) as u64,
+        replacement_score,
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use rsshogi::types::{Bitboard, Square};
+
+    #[test]
+    fn checks_and_near_king_captures_expose_both_obstacle_traps() {
+        let fixtures = [
+            (
+                "p1+pgp4/bs1k3p+B/1+lp2+N3/2sp5/2g5p/6P2/1PPP3PP/P+N+SLP2G1/2K1S1RN1 w RGNL3Pl 40",
+                &["2e"][..],
+                "L*4a",
+                "6a5b",
+            ),
+            (
+                "p3+R4/1k2+P3+B/+p1ps5/3p1+R3/K2l5/9/7PP/P2PP2G1/4S2N1 w B3G2S3N3L6P 94",
+                &["3d", "2d", "1d", "3e", "2e", "1e", "3f", "2f", "1f"][..],
+                "9c9d",
+                "6e6h+",
+            ),
+        ];
+        board::init();
+        for (sfen, holes, losing, alternative) in fixtures {
+            let mut position = board::position_from_sfen(sfen).unwrap();
+            let mut mask = Bitboard::EMPTY;
+            for hole in holes {
+                mask.set(Square::from_usi(hole).unwrap());
+            }
+            assert!(position.set_obstacle_mask(mask));
+            let attacker = position.turn().flip();
+            let losing = position.move32_from_usi(losing).unwrap();
+            let alternative = position.move32_from_usi(alternative).unwrap();
+            let mut probe = Probe { start: Instant::now(), budget: Duration::MAX, nodes: 0 };
+            assert_eq!(compare_after(&mut probe, &mut position, attacker, losing), Some(true));
+            assert_eq!(
+                compare_after(&mut probe, &mut position, attacker, alternative),
+                Some(false)
+            );
+            assert_eq!(position.to_sfen(None), sfen);
+            assert_eq!(position.obstacle_mask(), mask);
+        }
+    }
+}
