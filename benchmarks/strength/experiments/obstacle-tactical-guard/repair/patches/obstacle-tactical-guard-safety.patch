+fn exact_replacement_safety(
+    probe: &mut Probe,
+    position: &mut Position,
+    attacker: Color,
+    mv: Move32,
+) -> Option<bool> {
+    position.apply_move32(mv);
+    let safe = probe.exact_forced(position, attacker, REPLACEMENT_SAFETY_HORIZON).map(|loss| !loss);
+    position.undo_move32(mv).expect("replacement was legal");
+    safe
