+    /// Full-width terminal proof for screening a replacement. Exhaustion is unknown.
+    fn exact_forced(
+        &mut self,
+        position: &mut Position,
+        attacker: Color,
+        remaining: u8,
+    ) -> Option<bool> {
+        if !self.alive() {
+            return None;
+        }
+        self.nodes += 1;
+        let attacking = position.turn() == attacker;
+        if remaining == 0 {
+            return Some(!attacking && position.is_mated());
+        }
+        if attacking && solve_mate_in_one(position).is_some() {
+            return Some(true);
+        }
+        let mut moves = Move32List::new();
+        board::generate_legal_all_move32(position, &mut moves);
+        for &mv in moves.as_slice() {
+            position.apply_move32(mv);
+            let won = self.exact_forced(position, attacker, remaining - 1);
+            position.undo_move32(mv).expect("exact safety move was legal");
+            if won? == attacking {
+                return Some(attacking);
+            }
+        }
+        Some(!attacking)
+    }
 }

