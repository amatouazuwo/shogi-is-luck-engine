+    #[test]
+    fn exact_screen_rejects_a_faster_mate_that_the_selective_screen_misses() {
+        board::init();
+        let mut position = board::position_from_sfen("9/9/9/2s6/9/9/3K3b1/9/k1rg5 b g 1").unwrap();
+        let mut mask = Bitboard::EMPTY;
+        for hole in ["5d", "4d", "3d", "5e", "4e", "3e", "5f", "4f", "3f"] {
+            mask.set(Square::from_usi(hole).unwrap());
+        }
+        assert!(position.set_obstacle_mask(mask));
+        let attacker = position.turn().flip();
+        let incumbent = position.move32_from_usi("6g5h").unwrap();
+        let unsafe_alternative = position.move32_from_usi("6g6f").unwrap();
+        let mut probe = Probe { start: Instant::now(), budget: Duration::MAX, nodes: 0 };
+        assert_eq!(compare_after(&mut probe, &mut position, attacker, incumbent), Some(true));
+        assert_eq!(
+            compare_after(&mut probe, &mut position, attacker, unsafe_alternative),
+            Some(false)
+        );
+        assert_eq!(
+            exact_replacement_safety(&mut probe, &mut position, attacker, unsafe_alternative),
+            Some(false)
+        );
+        assert_eq!(
+            exact_replacement_safety(&mut probe, &mut position, attacker, incumbent),
+            Some(true)
+        );
+        probe.nodes = MAX_NODES;
+        assert_eq!(exact_replacement_safety(&mut probe, &mut position, attacker, incumbent), None);
+    }
