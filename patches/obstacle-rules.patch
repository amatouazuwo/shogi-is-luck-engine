diff --git a/crates/rsshogi/tests/shogiluck_holes.rs b/crates/rsshogi/tests/shogiluck_holes.rs
new file mode 100644
index 0000000000000000000000000000000000000000..1046a531368569df7fdf31d804fc9ca7e8cfff84
--- /dev/null
+++ b/crates/rsshogi/tests/shogiluck_holes.rs
@@ -0,0 +1,125 @@
+use rsshogi::board::{self, Bitboard, MoveList, Position, movegen::generate_legal_all};
+use rsshogi::types::{Move, Square};
+fn sq(s: &str) -> Square {
+    Move::from_usi(&format!("7g{s}")).unwrap().to_sq()
+}
+fn setup(sfen: &str, holes: &[&str]) -> Position {
+    board::init();
+    let mut p = board::position_from_sfen(sfen).unwrap();
+    let mut mask = Bitboard::EMPTY;
+    for s in holes {
+        mask.set(sq(s));
+    }
+    assert!(p.set_obstacle_mask(mask));
+    p
+}
+fn has(p: &Position, s: &str) -> bool {
+    let mut list = MoveList::new();
+    generate_legal_all(p, &mut list);
+    list.as_slice().contains(&Move::from_usi(s).unwrap())
+}
+#[test]
+fn rook_block_and_drop() {
+    let p = setup("k8/9/9/9/9/9/4R4/9/8K b G 1", &["5e"]);
+    assert!(has(&p, "5g5f"));
+    assert!(!has(&p, "5g5e"));
+    assert!(!has(&p, "5g5d"));
+    assert!(!has(&p, "G*5e"));
+    assert!(has(&p, "G*4e"));
+    assert!(!has(&p.clone_for_search(), "5g5d"));
+}
+#[test]
+fn knight_and_multiple_holes() {
+    let p = setup("k8/9/9/9/9/9/4N4/9/8K b G 1", &["5f", "4f", "6f", "4e"]);
+    assert!(has(&p, "5g6e"));
+    assert!(!has(&p, "5g4e"));
+    assert!(!has(&p, "G*6f"));
+}
+#[test]
+fn rook_check_and_pin() {
+    let p = setup("k3r4/9/9/9/9/9/9/9/4K4 b - 1", &["5e"]);
+    assert!(!p.is_in_check());
+    let p = setup("k3r4/9/9/9/9/9/4G4/9/4K4 b - 1", &["5e"]);
+    assert!(has(&p, "5g4g"));
+    let p = setup("k3r4/9/9/9/9/9/4G4/9/4K4 b - 1", &[]);
+    assert!(!has(&p, "5g4g"));
+}
+#[test]
+fn blackhole_nine_squares_and_undo() {
+    let mut p = setup(
+        "k8/9/9/9/9/9/4R4/9/8K b G 1",
+        &["4d", "5d", "6d", "4e", "5e", "6e", "4f", "5f", "6f"],
+    );
+    let before = p.to_sfen(None);
+    let mut list = MoveList::new();
+    generate_legal_all(&p, &mut list);
+    for m in list.as_slice() {
+        assert!(
+            !["4d", "5d", "6d", "4e", "5e", "6e", "4f", "5f", "6f"]
+                .iter()
+                .any(|s| sq(s) == m.to_sq())
+        );
+    }
+    assert!(!has(&p, "5g5c"));
+    assert!(has(&p, "5g3g"));
+    let m = p.move32_from_move(Move::from_usi("5g3g").unwrap());
+    p.apply_move32(m);
+    p.undo_move32(m).unwrap();
+    assert_eq!(before, p.to_sfen(None));
+    assert!(!has(&p, "5g5f"));
+}
+#[test]
+fn mate_and_escape() {
+    let p = setup("4k4/4R4/4G4/9/9/9/9/9/8K w - 1", &["4a", "6a", "4b", "6b"]);
+    assert!(p.is_in_check());
+    let mut list = MoveList::new();
+    generate_legal_all(&p, &mut list);
+    assert!(list.as_slice().is_empty());
+    let p = setup("4k4/4R4/4G4/9/9/9/9/9/8K w - 1", &["6a", "4b", "6b"]);
+    assert!(has(&p, "5a4a"));
+}
+#[test]
+fn bishop_and_lance_block() {
+    let p = setup("k8/9/9/9/9/9/4B3L/9/8K b - 1", &["4f", "1e"]);
+    assert!(!has(&p, "5g3e"));
+    assert!(has(&p, "5g6f"));
+    assert!(has(&p, "1g1f"));
+    assert!(!has(&p, "1g1d"));
+}
+
+#[test]
+fn obstacle_creates_checking_mate_in_one() {
+    let mut p = setup("4k4/9/4G4/4R4/9/9/9/9/8K b - 1", &["4a", "6a", "4b", "6b"]);
+    let mate = rsshogi::mate::solve_mate_in_one(&p).expect("obstacle mate must be found");
+    assert!(p.is_legal_move32(mate));
+    p.apply_move32(mate);
+    assert!(p.is_in_check());
+    assert!(p.is_mated());
+    p.set_hirate();
+    assert!(p.obstacle_mask().is_empty());
+}
+
+#[test]
+fn holes_can_make_a_pawn_drop_illegal_mate() {
+    let sfen = "4k4/9/4G4/9/9/9/9/9/8K b P 1";
+    assert!(!has(&setup(sfen, &["4a", "6a", "4b", "6b"]), "P*5b"));
+    assert!(has(&setup(sfen, &["6a", "4b", "6b"]), "P*5b"));
+}
+
+#[test]
+fn check_generators_respect_impassable_squares() {
+    use rsshogi::board::Move32List;
+    use rsshogi::board::movegen::generate_checks_all_move32;
+
+    let sfen = "4k4/9/9/9/9/R8/9/9/8K b G 1";
+    for (holes, expected_rook, expected_drop) in
+        [(&[][..], true, true), (&["7f"][..], false, true), (&["5b"][..], false, false)]
+    {
+        let p = setup(sfen, holes);
+        let mut checks = Move32List::new();
+        generate_checks_all_move32(&p, &mut checks);
+        let has_check = |expected| checks.as_slice().iter().any(|mv| mv.to_usi() == expected);
+        assert_eq!(has_check("9f5f"), expected_rook);
+        assert_eq!(has_check("G*5b"), expected_drop);
+    }
+}
