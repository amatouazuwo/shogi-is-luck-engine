+#[cfg(test)]
+mod obstacle_search_tests {
+    use super::test_support::{depth_limits, run_result};
+    use super::*;
+    use rsshogi::types::{Bitboard, Move};
+    #[test]
+    fn forced_hole_terminal_win_search() {
+        rsshogi::board::init();
+        let mut p = rsshogi::board::position_from_sfen("4k4/9/9/3G1R3/9/9/9/9/8K b - 1").unwrap();
+        let mut holes = Bitboard::EMPTY;
+        for s in ["4a", "6a", "4b", "6b"] {
+            holes.set(Move::from_usi(&format!("7g{s}")).unwrap().to_sq());
+        }
+        assert!(p.set_obstacle_mask(holes));
+        assert!(!p.is_in_check());
+        assert!(!legal_moves(&p).is_empty(), "fixture has legal moves");
+        let result = run_result(p.clone_for_search(), depth_limits(4), 1);
+        let mv = result.best_move.expect("must find a move");
+        eprintln!(
+            "OBSTACLE_SEARCH best={} score={} depth={} nodes={}",
+            mv.to_usi(),
+            result.score,
+            result.depth,
+            result.nodes
+        );
+        assert!(p.is_legal_move32(mv));
+        p.apply_move32(mv);
+        assert!(result.score >= MATE - 4, "must recognize terminal win");
+        assert!(legal_moves(&p).is_empty(), "must find terminal win in one");
+        eprintln!(
+            "OBSTACLE_TERMINAL check={} best={} depth={} nodes={}",
+            p.is_in_check(),
+            mv.to_usi(),
+            result.depth,
+            result.nodes
