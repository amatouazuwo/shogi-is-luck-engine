+    #[test]
+    fn genuine_mate_with_remaining_escape_square() {
+        rsshogi::board::init();
+        let mut p = rsshogi::board::position_from_sfen("4k4/9/4G4/4R4/9/9/9/9/8K b - 1").unwrap();
+        let mut holes = Bitboard::EMPTY;
+        for s in ["6a", "4b", "6b"] {
+            holes.set(Move::from_usi(&format!("7g{s}")).unwrap().to_sq());
+        }
+        assert!(p.set_obstacle_mask(holes));
+        let checking_mates: Vec<_> = legal_moves(&p)
+            .into_iter()
+            .filter(|&m| {
+                let mut child = p.clone_for_search();
+                child.apply_move32(m);
