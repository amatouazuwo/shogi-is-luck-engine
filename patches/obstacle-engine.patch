+
+    pub fn set_obstacle_position(&mut self, sfen: &str, holes: &[String]) -> Result<(), String> {
+        use rsshogi::types::{Bitboard, Square};
+        let fields: Vec<_> = sfen.split_whitespace().collect();
+        if fields.len() != 4 {
+            return Err("expected four SFEN fields".into());
+        }
+        crate::position::validate_sfen_hands(fields[2])?;
+        let mut position = board::position_from_sfen(sfen).map_err(|e| e.to_string())?;
+        let mut mask = Bitboard::EMPTY;
+        for square in holes {
+            let b = square.as_bytes();
+            if b.len() != 2 || !(b'1'..=b'9').contains(&b[0]) || !(b'a'..=b'i').contains(&b[1]) {
+                return Err("invalid obstacle square".into());
+            }
+            let sq = Square::from_usi(square).ok_or("invalid obstacle square")?;
+            if mask.test(sq) {
+                return Err("duplicate obstacle".into());
+            }
+            mask.set(sq);
+        }
+        if !position.set_obstacle_mask(mask) {
+            return Err("obstacle overlaps piece".into());
+        }
+        crate::position::validate_evaluable_position(&position)?;
+        position.set_entering_king_rule(EnteringKingRule::None);
+        self.install_position(position);
         Ok(())
     }

+    fn install_position(&mut self, position: Position) {
+        if self.position.obstacle_mask() != position.obstacle_mask() {
+            self.table.clear();
+            if let Some(coordinator) = &mut self.coordinator {
+                coordinator.clear();
+            }
+        }
+        self.position = position;
+    }
+
+    /// Returns the full legal move set for the current position in USI form.
+    pub fn legal_moves(&self) -> Vec<String> {
+        let mut list = board::Move32List::new();
+        board::generate_legal_all_move32(&self.position, &mut list);
+        list.as_slice().iter().map(|mv| mv.to_usi()).collect()
+    }
+
     pub fn new_game(&mut self) {
         self.position = initial_position();
         self.table.clear();
