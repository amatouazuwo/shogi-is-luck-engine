+        let mut holes = Bitboard::EMPTY;
+        for square in ["8a", "8b", "9b"] {
+            holes.set(rsshogi::types::Square::from_usi(square).unwrap());
+        }
+        assert!(position.set_obstacle_mask(holes));
+        assert!(!position.is_in_check());
+        assert!(position.is_mated());
+        assert_eq!(super::score::terminal_score(&position, 1, 0), Some(-MATE + 1));
